# PoC stand-in for CloudFront/Cloudflare in front of the MediaMTX HLS origin.
# It implements the same contract the real CDNs are configured with:
#   - add `Authorization: Bearer <hlsCDNSecret>` to every origin request
#   - add `X-Mtx-Stream: hls/<cabinet>/<camera>` (first three path segments),
#     the key Envoy consistent-hashes on so each camera always hits the same replica
#   - cache key = URL path only (no cookies, query strings or headers)
#   - honour the origin's Cache-Control (segments 3600s, media playlist
#     <segment duration>, multivariant playlist 30s)
#   - collapse concurrent misses into one origin request
# ${VARS} are filled in by the nginx image's envsubst at startup.
proxy_cache_path /var/cache/nginx/hls levels=1:2 keys_zone=hls:10m max_size=1g inactive=10m use_temp_path=off;

# /hls/<cabinet>/<camera>/<file> -> hls/<cabinet>/<camera>; empty (header not sent) otherwise.
map $uri $mtx_stream {
    "~^/(?<stream>[^/]+/[^/]+/[^/]+)/"  $stream;
    default                       "";
}

server {
    listen 8080;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass https://${ORIGIN_ADDRESS};
        proxy_http_version 1.1;
        proxy_set_header Host ${ORIGIN_HOST};
        proxy_ssl_server_name on;
        proxy_ssl_name ${ORIGIN_HOST};
        # PoC: the cluster CA isn't distributed to this namespace; the real
        # CDNs need a publicly trusted certificate on the origin.
        proxy_ssl_verify off;

        proxy_set_header Authorization "Bearer ${CDN_SECRET}";
        proxy_set_header X-Mtx-Stream $mtx_stream;
        proxy_set_header Cookie "";

        proxy_cache hls;
        proxy_cache_key $uri;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;

        add_header X-Cache $upstream_cache_status always;
    }
}
